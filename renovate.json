{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":disableDependencyDashboard",
    "gitlab>phpboyscout/cicd"
  ],
  "platform": "gitlab",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prCreation": "immediate",
  "dependencyDashboard": false,
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Auto-merge patch + minor for trusted ecosystems; majors require human review",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Major bumps land as draft MRs for review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "draftPR": true
    },
    {
      "description": "Go module updates land grouped on Mondays to keep go.sum churn low",
      "matchManagers": ["gomod"],
      "schedule": ["before 9am on monday"],
      "groupName": "gomod-weekly"
    },
    {
      "description": "GitLab CI component bumps grouped similarly",
      "matchManagers": ["gitlabci"],
      "schedule": ["before 9am on monday"],
      "groupName": "gitlab-ci-weekly"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "minimumReleaseAge": "0",
    "labels": ["security"]
  }
}
